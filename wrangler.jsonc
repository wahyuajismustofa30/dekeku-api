{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dekeku-api-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "wahyuajismustofa30",
    "GITHUB_REPO": "dekeku-db",
    "GITHUB_BRANCH": "main",
    "ALLOWED_ORIGINS": "https://dekeku.my.id,*.dekeku.my.id,https://artoprintingpbg.com,*.artoprintingpbg.com"
  },
  "previews": {
    "vars": {
      "GITHUB_OWNER": "wahyuajismustofa30",
      "GITHUB_REPO": "dekeku-db",
      "GITHUB_BRANCH": "main",
      "ALLOWED_ORIGINS": "https://dekeku.my.id,*.dekeku.my.id,https://artoprintingpbg.com,*.artoprintingpbg.com"
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DASHBOARD_REFRESH",
        "class_name": "DashboardRefreshCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-dashboard-refresh",
      "new_sqlite_classes": [
        "DashboardRefreshCoordinator"
      ]
    }
  ]
}
