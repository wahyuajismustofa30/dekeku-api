# DEKEKU API Gateway - Environment Variables Example
# Copy this file to .env or configure in Cloudflare Workers (wrangler secret / vars)

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name
GITHUB_BRANCH=main

# Authentication & Security
JWT_SECRET=your_secure_random_jwt_secret_here
ADMIN_PASSWORD_HASH=pbkdf2:100000:randomsalt16byteshex:hash32byteshex

# CORS Allowlist (Supports exact domains and wildcard subdomains like *.domain.com)
ALLOWED_ORIGINS=https://dekeku.my.id,*.dekeku.my.id,https://artoprintingpbg.com,*.artoprintingpbg.com
