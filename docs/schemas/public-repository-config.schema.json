{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEKEKU Public Project Repository Config",
  "description": "Public, non-secret metadata that identifies the GitHub repository owned by one website project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "repository"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "repo"],
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "not": {
            "enum": [".", ".."]
          }
        }
      }
    }
  }
}
